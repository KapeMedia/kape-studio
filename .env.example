# Gol = mod mock / local. Copiază în .env.local și completează ce ai.
DATABASE_URL=
STORAGE_DRIVER=local            # local | supabase | vercel-blob
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kape-studio
TEAM_PASSWORD=
AUTH_SECRET=                    # pentru cookie-ul semnat; în dev se generează unul în .data/auth-secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
DEFAULT_IMAGE_PROVIDER=openai   # openai | gemini | mock
